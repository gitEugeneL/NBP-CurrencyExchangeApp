.backdrop {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--modal-color);
  backdrop-filter: blur(15px);
  justify-content: center;
  align-items: center;
  z-index: 1;
}

.modalBackdropActive {
  display: flex;
}

.modal {
  max-width: 400px;
  padding: 20px;
  border-radius: var(--radius20);
  box-sizing: var(--shadow-3);
  background-color: var(--black-blue-color);
}

.title {
  color: var(--white-color);
  font-weight: var(--font-weight-semi-bold);
  text-align: center;
  margin-bottom: 20px;
}

.buttonContainer {
  display: flex;
  gap: var(--gap16);
}
