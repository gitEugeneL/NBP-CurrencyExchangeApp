.container {
  display: flex;
  align-items: center;
  gap: var(--gap20);
  position: relative;
  padding: 18px;
  cursor: pointer;
  text-decoration: none;
  box-sizing: border-box;
  transition:
    background-color 0.25s ease,
    border-right-color 0.25s ease;

  &:focus,
  &:hover {
    background-color: var(--violet-dark-color);
  }
}

.active {
  background-color: var(--violet-dark-color);
  border-right: 4px solid var(--primary-color);
}

.text {
  margin-left: 95px;
  color: var(--white-color);
  font-size: var(--font-size18);
  text-decoration: none;
}

.icon {
  position: absolute;
  top: 17px;
  left: 70px;
  text-decoration: none;
}

@media (--breakpoint-tablet) {
  .container {
    display: block;
    padding-right: 10px;
    box-sizing: border-box;
  }

  .active {
    border-right: none;
    border-bottom: 4px solid var(--primary-color);
  }

  .text {
    font-size: var(--font-size14);
    margin-left: 30px;
  }

  .icon {
    top: 16px;
    left: 15px;
  }
}
