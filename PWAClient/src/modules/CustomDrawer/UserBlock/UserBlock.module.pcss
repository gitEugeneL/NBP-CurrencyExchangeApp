.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap30);
  margin-top: 40px;
  margin-bottom: 50px;
}

.wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap5);
}

.name {
  font-size: var(--font-size18);
  color: var(--white-color);
}

.modal {
  display: none;
  transition: background-color 0.5s ease;
}

.email {
  font-size: var(--font-size16);
  color: var(--gray-color);
}

@media (--breakpoint-tablet) {
  .container {
    flex-direction: row;
    justify-content: flex-end;
  }

  .image {
    width: 25px;
    cursor: pointer;
  }

  .wrapper {
    display: none;
  }

  .modalWrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap10);
  }

  .active {
    display: flex;
  }

  .modal {
    gap: var(--gap20);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 75px;

    background-color: var(--violet-dark-color);
    border-radius: var(--radius16);
    box-shadow: var(--shadow-3);

    width: 250px;
    height: 150px;
    z-index: 1;
  }

  .name {
    font-size: var(--font-size20);
  }

  .modalWrapper {
    display: flex;
    flex-direction: column;
    gap: var(--gap5);
  }

  .button {
    width: 80%;
  }
}
